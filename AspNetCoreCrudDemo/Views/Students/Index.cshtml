@model IEnumerable<AspNetCoreCrudDemo.Models.Student>

@{
    ViewData["Title"] = "Student Dashboard";
    var totalStudents = Model?.Count() ?? 0;
    var totalCourses = Model?.Select(s => s.Course).Distinct().Count() ?? 0;
}

<div class="dashboard-container">

    <div class="welcome-banner">
        <div>
            <h1>🎓 Student Management System</h1>
            <p>Manage Students Easily and Efficiently 💗</p>
        </div>
        <div class="banner-icon">📚</div>
    </div>

    <div class="stats-container">

        <div class="stat-card pink">
            <div class="stat-icon">👩‍🎓</div>
            <div>
                <h2>@totalStudents</h2>
                <p>Total Students</p>
            </div>
        </div>

        <div class="stat-card purple">
            <div class="stat-icon">📖</div>
            <div>
                <h2>@totalCourses</h2>
                <p>Total Courses</p>
            </div>
        </div>

        <div class="stat-card blue">
            <div class="stat-icon">✨</div>
            <div>
                <h2>Welcome!</h2>
                <p>Keep Learning</p>
            </div>
        </div>

    </div>

    <div class="students-section">

        <div class="section-header">
            <h2>👩‍🎓 Students List</h2>

            <a asp-action="Create" class="add-student-btn">
                + Add New Student
            </a>
        </div>

        <div class="search-container">
            <input type="text" id="studentSearch"
                   placeholder="🔍 Search student by name, email or course..." />
        </div>

        <div class="table-responsive">
            <table class="student-table" id="studentsTable">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Student Name</th>
                        <th>Email</th>
                        <th>Course</th>
                        <th>Enrollment Date</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        var count = 1;

                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@count</td>
                                <td class="student-name">👤 @item.Name</td>
                                <td>@item.Email</td>
                                <td><span class="course-badge">@item.Course</span></td>
                                <td>
                                    @(item.EnrollmentDate?.ToString("dd MMM yyyy") ?? "Not provided")
                                </td>
                                <td class="action-buttons">
                                    <a asp-action="Details"
                                       asp-route-id="@item.StudentId"
                                       class="details-btn">Details</a>

                                    <a asp-action="Edit"
                                       asp-route-id="@item.StudentId"
                                       class="edit-btn">Edit</a>

                                    <a asp-action="Delete"
                                       asp-route-id="@item.StudentId"
                                       class="delete-btn">Delete</a>
                                </td>
                            </tr>

                            count++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="empty-message">
                                No students found. Add your first student! 💗
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

    </div>

    <div class="dashboard-footer">
        💗 Knowledge is Power — Keep Growing! 💗
    </div>

</div>

<script>
    document.getElementById("studentSearch").addEventListener("keyup", function () {
        var searchValue = this.value.toLowerCase();
        var rows = document.querySelectorAll("#studentsTable tbody tr");

        rows.forEach(function (row) {
            var rowText = row.innerText.toLowerCase();
            row.style.display = rowText.includes(searchValue) ? "" : "none";
        });
    });
</script>
